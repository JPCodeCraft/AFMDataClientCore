<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>0.1.0</Version>
    <RepositoryUrl>https://github.com/JPCodeCraft/AFMDataClientCore</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.1" />
    <InternalsVisibleTo Include="PowBench" />
    <InternalsVisibleTo Include="PowBench.Tests" />
    <InternalsVisibleTo Include="AFMDataClientMaui.Pow.Tests" />
    <InternalsVisibleTo Include="AFMDataClient.Core.Pow.Tests" />
  </ItemGroup>
</Project>
